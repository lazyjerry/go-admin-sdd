go.work
go.work.sum

# Go modules
vendor/
go.sum

# Environment and config files
.env
.env.local
.env.*.local
config/settings.dev.yml
config/settings.dev.*.yml
config/settings.dev.*.yml.log
config/settings.deva.yml
config/settings.b.dev.yml
config/settings.local.yml

# Database files
*.db
*.sqlite
*.sqlite3
go-admin-db.db
data/
temp/
!temp/
temp/logs/

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# macOS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js (for frontend development)
node_modules/
npm-debug.log*
yarn-debug.log*
